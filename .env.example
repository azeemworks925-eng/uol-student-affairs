DJANGO_SECRET_KEY=replace-this-later
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=uol_student_affairs
DB_USER=uol_app
DB_PASSWORD=replace-with-your-generated-mysql-password
DB_HOST=localhost
DB_PORT=3306

# Google OAuth client (Google Cloud Console). Leave empty to disable Google sign-in.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# UOL identity rules. Confirm these values before deployment (docs/technical/AUTHENTICATION.md).
UOL_STAFF_EMAIL_DOMAINS=uol.edu.pk
UOL_GOOGLE_REQUIRE_HOSTED_DOMAIN=True
UOL_GOOGLE_ALLOWED_HOSTED_DOMAINS=student.uol.edu.pk,uol.edu.pk

# Optional. Defaults: 28800 seconds (8 hours); secure cookies whenever DEBUG is False.
# DJANGO_SESSION_COOKIE_AGE=28800
# DJANGO_SECURE_COOKIES=False
